<h2>Leaderboard</h2>

<table>
  <thead>
    <tr>
      <th>Rank</th>
      <th>Player</th>
      <th>Wins</th>
      <th>Losses</th>
    </tr>
  </thead>

  <tbody>
    <% @players.each_with_index do |player, index| %>
      <tr>
        <td>#<%= index + 1 %></td>
        <td><%= player.name %></td>
        <td><%= player.wins_count %></td>
        <td><%= player.losses_count %></td>
      </tr>
    <% end %>
  </tbody>
</table>
