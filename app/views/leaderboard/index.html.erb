<h2>Leaderboard</h2>

<table border="1" cellpadding="5">
  <thead>
    <tr>
      <th>Rank</th>
      <th>Name</th>
      <th>Wins</th>
      <th>Losses</th>
    </tr>
  </thead>

  <tbody>
    <% @players.each_with_index do |player, index| %>
      <tr>
        <td><%= index + 1 %></td>
        <td><%= player.name %></td>
        <td><%= player.wins_count %></td>
        <td><%= player.losses_count %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to "Back to Home", root_path %>
