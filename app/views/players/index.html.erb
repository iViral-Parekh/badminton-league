<h2>Players</h2>

<%= link_to "Add Player", new_player_path %>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @players.each do |player| %>
      <tr>
        <td><%= player.name %></td>
        <td>
          <%= link_to "View", player %> |
          <%= link_to "Delete", player,
              method: :delete,
              data: { confirm: "Are you sure?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
