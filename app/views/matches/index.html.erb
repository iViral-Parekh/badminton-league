<h2>Matches</h2>

<%= link_to "Record Match", new_match_path, class: "button" %>

<table>
  <thead>
    <tr>
      <th>Winner</th>
      <th>Loser</th>
      <th>Date</th>
    </tr>
  </thead>

  <tbody>
    <% @matches.each do |match| %>
      <tr>
        <td><strong><%= match.winner.name %></strong></td>
        <td><%= match.loser.name %></td>
        <td><%= match.created_at.strftime("%d %b %Y") %></td>
      </tr>
    <% end %>
  </tbody>
</table>
